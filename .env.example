# Скопируйте в .env и задайте свои значения. .env в git не попадает.
POSTGRES_DB=pcbuilder
POSTGRES_USER=pcbuilder
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

API_PORT=8000
# Загружать каталог при старте контейнера, если таблица components пуста
SEED_ON_START=true

# Владелец образа в ghcr.io (ваш GitHub-логин в нижнем регистре)
GHCR_OWNER=your-github-username
# Тег образа для выката/отката: latest, 0.1.0, 0.2.0 ...
IMAGE_TAG=latest
